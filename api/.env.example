# =============================================================================
# Application
# =============================================================================
APP_ENV=development           # development | staging | production
PORT=8080
LOG_LEVEL=info                # info | debug
PUBLIC_BASE_URL=http://localhost:8080

# =============================================================================
# Base de donnees / cache
# =============================================================================
DATABASE_URL=postgres://plugiit:plugiit@localhost:5432/plugiit?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Applique les migrations embarquees au demarrage.
RUN_MIGRATIONS=true

# =============================================================================
# Authentification
# =============================================================================
# 32 octets minimum. Generer avec : openssl rand -base64 48
JWT_SECRET=changeme-changeme-changeme-changeme
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Domaine du cookie de session. Vide en local ; en prod : .plugiit.com
# pour que admin.plugiit.com et api.plugiit.com le partagent.
COOKIE_DOMAIN=

# =============================================================================
# CORS
# =============================================================================
# Origines de l'admin, separees par des virgules. Pas de wildcard possible :
# les cookies exigent une origine explicite.
ADMIN_ORIGINS=http://localhost:5173

# =============================================================================
# Timeouts
# =============================================================================
READ_TIMEOUT=30s
WRITE_TIMEOUT=30s
SHUTDOWN_TIMEOUT=15s
