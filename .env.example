# Installation hors Coolify uniquement. Sous Coolify, ces valeurs sont generees
# et saisies dans l'interface : ce fichier ne sert pas.
#
# Copier en .env, puis remplacer chaque valeur marquee A_GENERER.

# URL publique de l'application, sans slash final (celle du reverse proxy).
SERVICE_URL_APP_8080=https://piilot.example.fr
SERVICE_URL_APP=https://piilot.example.fr

# Identifiants Postgres et Redis. Alphanumeriques uniquement : ils entrent
# tels quels dans des URLs de connexion.
#   openssl rand -hex 16
SERVICE_USER_POSTGRES=piilot
SERVICE_PASSWORD_POSTGRES=A_GENERER
SERVICE_PASSWORD_REDIS=A_GENERER

# Secret de signature des jetons, 32 caracteres minimum.
#   openssl rand -hex 32
SERVICE_PASSWORD_64_JWT=A_GENERER

# Port d'ecoute sur l'hote, en 127.0.0.1 (voir docker-compose.selfhost.yml).
APP_PORT=8080

# Tout le reste a une valeur par defaut dans docker-compose.yml et peut etre
# surcharge ici : APP_ENV, LOG_LEVEL, COOKIE_DOMAIN, POSTGRES_DB, MAX_UPLOAD_MIB...
