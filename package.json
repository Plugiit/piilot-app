{
  "name": "plugiit-app-reactjs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run routes:gen && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint src",
    "types:check": "tsc -b --noEmit false --emitDeclarationOnly false",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run routes:gen && npm run lint && tsc -b && npm run test",
    "api:types": "openapi-typescript ${VITE_API_URL:-http://localhost:8080}/openapi.json -o src/types/api-generated.ts",
    "routes:gen": "tsr generate"
  },
